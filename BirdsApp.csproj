<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe: a normal Windows app, so no black console window opens behind the game -->
    <OutputType>WinExe</OutputType>
    <AssemblyName>BirbBox</AssemblyName>
    <ApplicationIcon>resources\icon.ico</ApplicationIcon>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
    <PackageReference Include="Raylib-cs" Version="8.0.0" />
    <PackageReference Include="rlImgui-cs" Version="3.2.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="resources\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
